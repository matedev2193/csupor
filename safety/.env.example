# Separate app, database, secret and persistent private PDF directory.
SAFETY_DATABASE_URL=mysql+mysqlconnector://safety_user:CHANGE_ME@db-host/micimacko_safety
SAFETY_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SAFETY_UPLOAD_DIR=/var/lib/micimacko-safety/materials
SAFETY_OIDC_ISSUER=https://fiok.example.hu
SAFETY_OIDC_CLIENT_ID=munkavedelem
SAFETY_OIDC_CLIENT_SECRET=REPLACE_WITH_REGISTERED_CLIENT_SECRET
SAFETY_OIDC_REDIRECT_URI=https://munkavedelem.example.hu/auth/callback
SAFETY_SESSION_TTL=3600
SAFETY_PROXY_HOPS=1
SAFETY_ALLOW_HTTP=false
