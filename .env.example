SECRET_KEY=change-me

# Optional separate encryption key for saved SMTP credentials. Keep this stable.
# Alternatively, use Settings > Create encryption key (no terminal required).
# Without a separate key, an existing non-default SECRET_KEY remains supported.
# Replace the sample SECRET_KEY for secure Flask sessions.
# EMAIL_SECRET_KEY=
# Built-in notification worker defaults to true with MySQL, false with SQLite.
# Set false when using a separately supervised `flask --app run notifications worker`.
# EMAIL_WORKER_ENABLED=true

# Option A: Provide full SQLAlchemy URL
# DATABASE_URL=mysql+mysqlconnector://root:your_password@localhost:3306/csupor

# Option B: Provide individual MySQL values (used when DATABASE_URL is unset)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=csupor

# First startup creates the database (if the hosting account permits it),
# missing tables and required defaults automatically; no SQL import is needed.
# On managed hosting, create/select an empty database in the provider's panel
# if the application account cannot create databases. It still needs permission
# to create its tables; existing installations may also need ALTER for upgrades.

# Optional first administrator: set all three values in the hosting panel.
# Mark INITIAL_ADMIN_PASSWORD as encrypted/secret. Use your own login password,
# separate from SECRET_KEY. No account is created when these are unset.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# The account receives developer privilege only when no developer exists yet.
# Remove all three variables after the first successful administrator login.

# Shared Micimackó accounts: read docs/shared-accounts.md before enabling.
# Existing installations keep working locally until a controlled migration.
AUTH_MODE=local
# AUTH_MODE=oidc
# OIDC_ISSUER=https://fiok.example.hu
# OIDC_CLIENT_ID=csupor
# OIDC_CLIENT_SECRET=generate-a-separate-random-client-secret
# Exact callback registered in the account service; do not derive from Host.
# OIDC_REDIRECT_URI=https://csupor.example.hu/auth/callback
# OIDC_SESSION_TTL=3600
# Loopback development only (never on public hosting):
# AUTH_ALLOW_HTTP=true
