# Independent service; use a dedicated database and a different session key.
ACCOUNTS_DATABASE_URL=mysql+mysqlconnector://accounts_user:password@localhost/micimacko_accounts
# Generate a unique random secret with at least 32 characters before startup.
ACCOUNTS_SECRET_KEY=
ACCOUNTS_ISSUER=https://fiok.example.hu
ACCOUNTS_SIGNING_KEY_FILE=/run/secrets/accounts-signing-key.pem
ACCOUNTS_TOKEN_TTL=3600
# Local development only; production must remain false.
ACCOUNTS_ALLOW_HTTP=false
# Trust forwarded client IP and protocol only behind this exact number of trusted proxies.
ACCOUNTS_PROXY_HOPS=0
ACCOUNTS_SMTP_HOST=
ACCOUNTS_SMTP_PORT=587
ACCOUNTS_SMTP_USERNAME=
ACCOUNTS_SMTP_PASSWORD=
ACCOUNTS_SMTP_FROM=
ACCOUNTS_SMTP_STARTTLS=true
