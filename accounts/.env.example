# Separate service. Configure these in DigitalOcean Run Time environment variables.
# This file is not loaded automatically. Never commit actual secrets.
ACCOUNTS_DATABASE_URL=mysql://accounts_user:CHANGE_ME@mysql.nethely.hu:3306/accounts_user
# Verified TLS and the OS trust store are automatic; no ssl-mode flag needed.
# Nethely without TLS: set this one additional Run Time variable explicitly.
# This sends database traffic without TLS; the website's HTTPS is unchanged.
# ACCOUNTS_DATABASE_TLS_MODE=disabled
# Omit the variable (or set required) for verified TLS. An explicit disabled
# value overrides an old ?ssl-mode=REQUIRED suffix and ignores stale CA values.
# Optional only for a provider's private CA (e.g. DigitalOcean Managed MySQL):
# ACCOUNTS_DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
ACCOUNTS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCOUNTS_SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# First deploy: leave blank to start only the domain-setup page, without DB access.
# After attaching the domain: set https://fiok.matedev.hu and deploy again.
ACCOUNTS_ISSUER=
# New deployments store their generated RSA key encrypted in the own database.
# Legacy installations can keep their private mounted RSA key:
# ACCOUNTS_SIGNING_KEY_FILE=/run/secrets/accounts-signing-key.pem
ACCOUNTS_TOKEN_TTL=3600
# Local development only; production must remain false.
ACCOUNTS_ALLOW_HTTP=false
# Trust forwarded client IP and protocol only behind this exact number of trusted proxies.
ACCOUNTS_PROXY_HOPS=1
ACCOUNTS_SMTP_HOST=
ACCOUNTS_SMTP_PORT=587
ACCOUNTS_SMTP_USERNAME=
ACCOUNTS_SMTP_PASSWORD=
ACCOUNTS_SMTP_FROM=
ACCOUNTS_SMTP_STARTTLS=true
