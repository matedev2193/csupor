#: app/worktime.py:282
msgid "The draft register has been generated. Review the warnings before verifying it."
msgstr ""
"Elkészült a munkaidő-nyilvántartás tervezete. Az ellenőrzöttnek jelölés előtt nézd át a "
"figyelmeztetéseket."

#: app/worktime.py:307
msgid "The register has been verified."
msgstr "A munkaidő-nyilvántartást ellenőrzöttnek jelöltük."

#: app/worktime.py:376
msgid "The entry has been saved. Review the updated scheduling warnings."
msgstr "A bejegyzést mentettük. Nézd át a frissített beosztási figyelmeztetéseket."

#: app/worktime.py:513
msgid "Group merge saved. Regenerate the monthly register."
msgstr "A csoportösszevonást mentettük. Generáld újra a havi munkaidő-nyilvántartást."

#: app/worktime.py:146 app/worktime.py:159 app/worktime.py:281
msgid "The register changed in another window. Reload the page and try again."
msgstr "A nyilvántartás egy másik ablakban megváltozott. Töltsd újra az oldalt, majd próbáld újra."

#: app/worktime.py:151
msgid "The register is out of date. Regenerate it before making changes."
msgstr "A nyilvántartás nem naprakész. Módosítás előtt generáld újra."

#: app/worktime.py:250
msgid "Confirm that manual changes may be replaced before regenerating."
msgstr "Az újragenerálás előtt erősítsd meg, hogy a kézi módosítások felülírhatók."

#: app/worktime.py:293
msgid "Generate employee entries before verifying the register."
msgstr "Az ellenőrzöttnek jelölés előtt generáld le a munkavállalók bejegyzéseit."

#: app/worktime.py:298
msgid "Resolve every scheduling conflict before verifying the register."
msgstr "Az ellenőrzöttnek jelölés előtt oldj fel minden beosztási ütközést."

#: app/worktime.py:300
msgid "Confirm that you have checked the entries against actual attendance."
msgstr "Erősítsd meg, hogy a bejegyzéseket összevetetted a tényleges jelenléttel."

#: app/worktime.py:339
msgid "Keep the note within 2,000 characters."
msgstr "A megjegyzés legfeljebb 2000 karakter lehet."

#: app/worktime.py:341
msgid "Enter both the start and end of the working day."
msgstr "Add meg a munkaidő kezdetét és végét is."

#: app/worktime.py:411
msgid "Group settings saved. Regenerate affected registers."
msgstr "A csoportbeállításokat mentettük. Generáld újra az érintett nyilvántartásokat."

#: app/worktime.py:426
msgid "The end date cannot be before the start date."
msgstr "A záró dátum nem lehet korábbi a kezdő dátumnál."

#: app/worktime.py:437
msgid "Enter a group name of at most 120 characters."
msgstr "Adj meg egy legfeljebb 120 karakteres csoportnevet."

#: app/worktime.py:456
msgid "Choose a contract and group at the same workplace."
msgstr "Azonos munkavégzési helyhez tartozó szerződést és csoportot válassz."

#: app/worktime.py:463
msgid "Choose the weekly shift pattern."
msgstr "Válaszd ki a heti műszakváltás rendjét."

#: app/worktime.py:470
msgid "This contract already has a group assignment during these dates."
msgstr "Ehhez a szerződéshez a megadott időszakban már tartozik csoportbeosztás."

#: app/worktime.py:529
msgid "Choose PDF or CSV for the export."
msgstr "Az exportáláshoz PDF- vagy CSV-formátumot válassz."

#: app/worktime.py:71
#, python-format
msgid "Choose a valid %(field)s."
msgstr "Válassz érvényes %(field)s."

#: app/worktime.py:83
msgid "Enter a valid date."
msgstr "Adj meg érvényes dátumot."

#: app/worktime.py:321
msgid "Enter a valid time in HH:MM format."
msgstr "Adj meg érvényes időpontot óó:pp formátumban."

#: app/worktime.py:352
msgid "A working day may contain at most eight working hours and a 20-minute break."
msgstr "Egy munkanap legfeljebb nyolc óra munkaidőből és 20 perc munkaközi szünetből állhat."

#: app/worktime.py:354
msgid "Place the 20-minute break inside the working day."
msgstr "A 20 perces munkaközi szünetet a munkanapon belülre helyezd."

#: app/worktime.py:358
msgid "An absent employee must have zero working time."
msgstr "Távollévő munkavállalónál a munkaidőnek nullának kell lennie."

#: app/worktime.py:390
msgid "Create a workplace before adding groups."
msgstr "Csoportok hozzáadása előtt hozz létre munkavégzési helyet."

#: app/worktime.py:393
msgid "Group settings changed in another window. Reload the page and try again."
msgstr "A csoportbeállítások egy másik ablakban megváltoztak. Töltsd újra az oldalt, majd próbáld újra."

#: app/worktime.py:460
msgid "The assignment must stay inside the contract and group dates."
msgstr "A beosztás időszakának a szerződés és a csoport érvényességi idején belül kell maradnia."

#: app/worktime.py:492
msgid "Choose a merge date inside the selected month."
msgstr "Az összevonás dátuma a kiválasztott hónapba essen."

#: app/worktime.py:496
msgid "Choose two different active groups at the same workplace."
msgstr "Válassz két különböző, aktív csoportot ugyanazon a munkavégzési helyen."

#: app/worktime.py:499
msgid "A group merge cannot form a chain or a cycle."
msgstr "A csoportösszevonások nem alkothatnak láncot vagy körkörös hivatkozást."

#: app/worktime.py:506
msgid "Keep the merge note within 255 characters."
msgstr "Az összevonás megjegyzése legfeljebb 255 karakter lehet."

#: app/worktime.py:364
msgid "Teaching minutes must be between zero and the working minutes."
msgstr "A neveléssel-oktatással lekötött percek száma nulla és a munkaidő perceinek száma között lehet."

#: app/worktime.py:410
msgid "This group name already exists at the workplace."
msgstr "Ezen a munkavégzési helyen már létezik ilyen nevű csoport."

#: app/worktime.py:442
msgid "The group dates must contain all existing assignments."
msgstr "A csoport érvényességi idejének minden meglévő beosztást le kell fednie."

#: app/worktime.py:445
msgid "The group dates must contain all existing group merges."
msgstr "A csoport érvényességi idejének minden meglévő csoportösszevonást le kell fednie."

#: app/worktime.py:405 app/worktime.py:483
msgid "Choose a valid action."
msgstr "Válassz érvényes műveletet."

#: app/worktime_service.py:243 app/worktime_service.py:248 app/worktime_service.py:256
msgid "This employee has no contract in the selected month."
msgstr "A munkavállalónak nincs szerződése a kiválasztott hónapban."

#: app/worktime.py:57 app/worktime_service.py:30 app/worktime_service.py:34
msgid "Choose a valid year and month."
msgstr "Válassz érvényes évet és hónapot."

#: app/worktime_service.py:248 app/worktime_service.py:253 app/worktime_service.py:261
msgid "Generate the register for every workplace before exporting this employee's month."
msgstr ""
"A munkavállaló havi nyilvántartásának exportálása előtt minden érintett munkavégzési helyen "
"generáld le a nyilvántartást."

#: app/worktime_service.py:251 app/worktime_service.py:256 app/worktime_service.py:264
msgid "The register is out of date. Regenerate it before exporting."
msgstr "A nyilvántartás nem naprakész. Exportálás előtt generáld újra."

#: app/worktime_service.py:212 app/worktime_service.py:217 app/worktime_service.py:225
msgid "Approved absence; regenerate the register."
msgstr "Jóváhagyott távollét; generáld újra a nyilvántartást."

#: app/templates/worktime.html:135
msgid ""
"For part-time employees, every working-time allowance is multiplied by the contract’s weekly "
"hours divided by 40."
msgstr "Részmunkaidőben minden munkaidőkeret a szerződéses heti óraszám és a 40 óra arányával csökken."

#: app/templates/base.html:69
msgid "Groups"
msgstr "Csoportok"

#: app/templates/worktime.html:24
msgid "Employee schedule"
msgstr "Munkavállaló beosztása"

#: app/templates/worktime.html:24
msgid "Choose from employees with a contract at the selected workplace in this month."
msgstr ""
"Az adott hónapban a kiválasztott munkavégzési helyen szerződéssel rendelkező munkavállalók közül "
"választhatsz."

#: app/templates/worktime.html:25
msgid "View schedule"
msgstr "Beosztás megtekintése"

#: app/templates/worktime.html:139
msgid ""
"Opening duty is assigned only to morning-shift employees. An absence may change the usual weekly "
"shift."
msgstr ""
"Nyitóügyeletre csak délelőttös munkavállaló osztható be. Távollét miatt az alapértelmezett heti "
"műszak változhat."

msgid "The early start is assigned to the same employee as on the preceding scheduled day."
msgstr "A korai kezdés az előző beosztott naphoz hasonlóan ugyanarra a munkavállalóra jut."

msgid "An early start can only be assigned to an employee who is on the morning shift that day."
msgstr "Korai kezdés csak az adott napon délelőttös munkavállalónak osztható ki."

msgid "No morning-shift teacher is available for the 07:00 opening duty."
msgstr "A 07:00-s nyitáshoz nincs elérhető délelőttös óvodapedagógus."

msgid "No morning-shift nursery assistant is available for the 06:00 opening duty."
msgstr "A 06:00-s nyitáshoz nincs elérhető délelőttös dajka."

msgid "The daily shift differs from the configured weekly shift."
msgstr "A napi műszak eltér a beállított heti műszaktól."

msgid "The group’s available teachers must include both a morning and an afternoon shift."
msgstr "A csoport jelen lévő óvodapedagógusai között délelőttösnek és délutánosnak is lennie kell."

