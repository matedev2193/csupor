#: app/approval_display.py:15
msgid "Select an active contract to see who needs to approve your leave."
msgstr "Válassz aktív szerződést a szükséges jóváhagyók megjelenítéséhez."

#: app/approval_display.py:41
#, python-format
msgid "Approval from %(names)s is required."
msgstr "%(names)s jóváhagyása szükséges."

#: app/approval_display.py:42
#, python-format
msgid "Approval from any one of %(names)s is sufficient."
msgstr "%(names)s közül bármelyikük jóváhagyása elegendő."

#: app/approval_display.py:46 app/approval_display.py:53
msgid "No director is assigned. Contact HR to arrange approval."
msgstr "Nincs kijelölt igazgató. A jóváhagyás rendezéséhez keresd a HR-t."

#: app/approval_display.py:48 app/approval_display.py:55
msgid "No eligible nursery head or deputy is assigned. Contact HR to arrange approval."
msgstr "Nincs jóváhagyásra jogosult óvodavezető vagy óvodavezető-helyettes kijelölve. Keresd a HR-t."

#: app/approval_display.py:51
msgid "No eligible approver is assigned. Contact HR to arrange approval."
msgstr "Nincs kijelölt, jóváhagyásra jogosult személy. Keresd a HR-t."

#: app/approval_display.py:63
#, python-format
msgid ""
"Approval from %(shared)s alone, or one approval from %(directors)s and one from %(leaders)s, is "
"required."
msgstr ""
"%(shared)s jóváhagyása önmagában elegendő; másik lehetőségként %(directors)s és %(leaders)s egy-"
"egy jóváhagyása szükséges."

#: app/approval_display.py:65
#, python-format
msgid "Both %(directors)s and %(leaders)s must approve."
msgstr "%(directors)s és %(leaders)s jóváhagyása egyaránt szükséges."

